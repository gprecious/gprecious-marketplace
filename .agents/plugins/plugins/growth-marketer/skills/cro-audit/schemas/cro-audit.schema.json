{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cro-audit",
  "description": "validated by scripts/validate-artifact.sh via x-required / x-required-item hints. page_url and evidence should preserve source traceability.",
  "type": "object",
  "x-required": ["page_url", "captured_at", "friction_items"],
  "properties": {
    "page_url": { "type": "string" },
    "captured_at": { "type": "string", "description": "ISO-8601 timestamp" },
    "page_type": { "type": "string", "enum": ["landing", "signup", "checkout", "paywall", "pricing", "other"] },
    "summary": { "type": "string" },
    "friction_items": {
      "type": "array",
      "items": {
        "type": "object",
        "x-required-item": ["area", "evidence", "severity", "recommendation"],
        "properties": {
          "area": {
            "type": "string",
            "enum": [
              "message_match",
              "cta_clarity",
              "trust_signals",
              "form_length",
              "signup_flow",
              "paywall",
              "pricing",
              "load_mobile",
              "navigation",
              "other"
            ]
          },
          "evidence": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "recommendation": { "type": "string" },
          "reference_ids": { "type": "array", "items": { "type": "string" } },
          "metric": { "type": "string" },
          "effort": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    }
  }
}
